# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib
scripts/
generate.go

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

.idea/

# Bot API docs snapshot used by the generator's golden tests — fetched on
# demand, never committed (curl -sSL -o internal/gen/testdata/api https://core.telegram.org/bots/api)
/internal/gen/testdata/api
